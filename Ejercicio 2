## 7. Modelo Relacional (sentencias SQL ejemplo)

```sql
CREATE TABLE Usuario (
  idUsuario INT PRIMARY KEY,
  tipo VARCHAR(20) NOT NULL -- 'Jugador' o 'Espectador'
);

CREATE TABLE Jugador (
  idJugador INT PRIMARY KEY,
  idUsuario INT UNIQUE,
  nickname VARCHAR(50),
  nivel INT,
  experiencia BIGINT,
  email VARCHAR(100),
  FOREIGN KEY (idUsuario) REFERENCES Usuario(idUsuario)
);

CREATE TABLE Espectador (
  idEspectador INT PRIMARY KEY,
  idUsuario INT UNIQUE,
  nickname VARCHAR(50),
  email VARCHAR(100),
  FOREIGN KEY (idUsuario) REFERENCES Usuario(idUsuario)
);

CREATE TABLE Perfil (
  idPerfil INT PRIMARY KEY,
  idUsuario INT UNIQUE,
  avatar VARCHAR(200),
  bio TEXT,
  preferencias TEXT,
  redesSociales TEXT,
  FOREIGN KEY (idUsuario) REFERENCES Usuario(idUsuario)
);

CREATE TABLE Juego (
  idJuego INT PRIMARY KEY,
  nombre VARCHAR(100),
  genero VARCHAR(50),
  plataforma VARCHAR(50)
);

CREATE TABLE Transmision (
  idTransmision INT PRIMARY KEY,
  idJugador INT,
  titulo VARCHAR(200),
  fechaHora DATETIME,
  duracion INT, -- duración en segundos
  visualizaciones INT,
  FOREIGN KEY (idJugador) REFERENCES Jugador(idJugador)
);

CREATE TABLE Torneo (
  idTorneo INT PRIMARY KEY,
  nombre VARCHAR(150),
  fechaInicio DATE,
  fechaFin DATE,
  premios TEXT
);

CREATE TABLE Partida (
  idPartida INT PRIMARY KEY,
  idTorneo INT,
  idJuego INT,
  fechaHora DATETIME,
  duracion INT,
  resultado TEXT,
  FOREIGN KEY (idTorneo) REFERENCES Torneo(idTorneo),
  FOREIGN KEY (idJuego) REFERENCES Juego(idJuego)
);

CREATE TABLE Equipo (
  idEquipo INT PRIMARY KEY,
  nombre VARCHAR(100),
  ranking INT
);

-- Relación N:M Jugador - Equipo
CREATE TABLE Jugador_Equipo (
  idJugador INT,
  idEquipo INT,
  fechaEntrada DATE,
  PRIMARY KEY (idJugador, idEquipo),
  FOREIGN KEY (idJugador) REFERENCES Jugador(idJugador),
  FOREIGN KEY (idEquipo) REFERENCES Equipo(idEquipo)
);

-- Relación N:M Equipo - Torneo (participación)
CREATE TABLE Equipo_Torneo (
  idEquipo INT,
  idTorneo INT,
  posicion INT,
  PRIMARY KEY (idEquipo, idTorneo),
  FOREIGN KEY (idEquipo) REFERENCES Equipo(idEquipo),
  FOREIGN KEY (idTorneo) REFERENCES Torneo(idTorneo)
);

-- Donaciones y comentarios apuntan a una Transmision y a un Espectador
CREATE TABLE Donacion (
  idDonacion INT PRIMARY KEY,
  idEspectador INT,
  idTransmision INT,
  monto DECIMAL(10,2),
  fechaHora DATETIME,
  FOREIGN KEY (idEspectador) REFERENCES Espectador(idEspectador),
  FOREIGN KEY (idTransmision) REFERENCES Transmision(idTransmision)
);

CREATE TABLE Comentario (
  idComentario INT PRIMARY KEY,
  idEspectador INT,
  idTransmision INT,
  contenido TEXT,
  fechaHora DATETIME,
  FOREIGN KEY (idEspectador) REFERENCES Espectador(idEspectador),
  FOREIGN KEY (idTransmision) REFERENCES Transmision(idTransmision)
);

-- Seguidores entre jugadores (autorreferencia)
CREATE TABLE Follow (
  follower INT, -- idJugador que sigue
  followed INT, -- idJugador seguido
  fechaFollow DATE,
  PRIMARY KEY (follower, followed),
  FOREIGN KEY (follower) REFERENCES Jugador(idJugador),
  FOREIGN KEY (followed) REFERENCES Jugador(idJugador)
);

-- Tablas opcionales para estadísticas
CREATE TABLE Estadistica_Jugador (
  idJugador INT,
  periodo VARCHAR(20),
  partidasJugadas INT,
  victorias INT,
  derrotas INT,
  PRIMARY KEY (idJugador, periodo),
  FOREIGN KEY (idJugador) REFERENCES Jugador(idJugador)
);

CREATE TABLE Estadistica_Torneo (
  idTorneo INT,
  periodo VARCHAR(20),
  totalPartidas INT,
  promedioDuracion INT,
  PRIMARY KEY (idTorneo, periodo),
  FOREIGN KEY (idTorneo) REFERENCES Torneo(idTorneo)
);
